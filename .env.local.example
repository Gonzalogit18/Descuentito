# =============================================================================
# Descuentito — variables de entorno
# Copiá este archivo a `.env.local` y completá los valores para activar el RAG
# real. Si lo dejás vacío (o no creás .env.local), la app funciona igual usando
# datos de demostración (mock). NO se necesitan claves para correr el demo.
# =============================================================================

# Clave de OpenAI (se usa SOLO en el servidor, nunca se expone al cliente).
# Necesaria para embeddings (text-embedding-3-small) y chat (gpt-4o-mini).
OPENAI_API_KEY=

# URL del proyecto Supabase, ej: https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Clave de Supabase. Preferentemente la SERVICE ROLE (server-side).
# Si solo tenés la anon key, podés ponerla en SUPABASE_ANON_KEY como fallback.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Nota: el RAG real espera una función RPC `match_promos` en Supabase con
# parámetros: query_embedding (vector), match_count (int), filtro_marca (text | null).
